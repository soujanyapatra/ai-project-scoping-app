APP_NAME=ScopeFlow.ai
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file

VITE_APP_NAME="${APP_NAME}"

FASTAPI_BASE_URL=http://localhost:9000
FASTAPI_RUN_PATH=/api/v1/scope
FASTAPI_MOCK=true
FASTAPI_TIMEOUT_SECONDS=120

CORS_ALLOWED_ORIGINS=*
